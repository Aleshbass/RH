# Test Environment Configuration
# Copy this to .env.test and fill in your values

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Test Admin Account (must exist in your test database)
TEST_ADMIN_EMAIL=admin@test.com
TEST_ADMIN_PASSWORD=Test123!@#

# Test Physiotherapist Account (must be APPROVED)
TEST_PHYSIO_EMAIL=approved-physio@test.com
TEST_PHYSIO_PASSWORD=Test123!@#

# Email Service (for email notification tests)
RESEND_API_KEY=re_xxxxx

# Optional: Test Patient Account
TEST_PATIENT_EMAIL=patient@test.com
TEST_PATIENT_PASSWORD=Test123!@#

# Optional: Clinic Owner Account
TEST_CLINIC_OWNER_EMAIL=clinic-owner@test.com
TEST_CLINIC_OWNER_PASSWORD=Test123!@#
