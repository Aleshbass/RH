# Environment variables for Rehabify Health (physioaroundme.com).
# Names only: never put real values in this file. Set them in Vercel (Next.js) and Convex
# (`npx convex env set NAME value`). Locally, copy the Next.js block into .env.local.

# ───────────────────────── Next.js (Vercel) ─────────────────────────

# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=
# Shared with Convex: lets API routes call server-only Convex functions
CONVEX_SERVER_SECRET=
CONVEX_JOY_GATEWAY_URL=
CONVEX_JOY_GATEWAY_SECRET=
CONVEX_PARTNER_GATEWAY_URL=
CONVEX_PARTNER_GATEWAY_SECRET=

# Clerk (read by @clerk/nextjs)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Site URLs
NEXT_PUBLIC_APP_URL=https://physioaroundme.com
APP_URL=
NEXT_PUBLIC_LEARN_URL=
NEXT_PUBLIC_ADMIN_URL=
PARTNER_API_BASE_URL=

# Offline mode (lib/pwa.ts, read at build time, so redeploy after changing it): "on" for everyone,
# "pilot" only for accounts an admin turned on in Admin > Users ("Offline pilot"), anything else off.
# Turning it off is the kill switch: phones wipe their stored pages and encrypted offline copy.
NEXT_PUBLIC_OFFLINE_MODE=

# Payments (Paystack): use live keys in production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PLATFORM_FEE_AMOUNT=

# MediLoan by MyItura (MyItura sends the loan SMS)
MYITURA_API_URL=
MYITURA_PUBLIC_KEY=
MYITURA_SECRET_KEY=
MYITURA_WEBHOOK_SECRET=
MYITURA_WEBHOOK_TOKEN=

# AwaDoc marketplace (lib/awadoc/awadoc.ts). Vercel only; Convex needs none of these.
AWADOC_PARTNER_ID=
# Production signing secret (sk_…); comma-separate two to overlap a rotation
AWADOC_SECRET_KEY=
# Optional: defaults to https://partners-api.awadoc.com
AWADOC_BASE_URL=
# Optional sandbox: events signed with this key are treated as tests and answered on the sandbox
AWADOC_TEST_SECRET_KEY=
AWADOC_TEST_BASE_URL=
AWADOC_TEST_PARTNER_ID=

# Joy (WhatsApp care assistant)
NEXT_PUBLIC_JOY_WHATSAPP_NUMBER=
JOY_EVENT_URL=
JOY_EVENT_HMAC_SECRET=
JOY_RH_INBOUND_KEY_ID=
JOY_RH_INBOUND_HMAC_SECRET=
JOY_SAFETY_ELIGIBILITY_URL=
JOY_SAFETY_HMAC_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=
RESEND_FROM_EMAIL=
DEMO_REQUEST_EMAIL=
PLATFORM_ADMIN_EMAIL=

# Maps, media, analytics, monitoring
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_WEB_VITALS_ENABLED=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: server/edge Sentry fall back to NEXT_PUBLIC_SENTRY_DSN
SENTRY_DSN=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Partner API key for server-to-server calls
REHABIFY_API_KEY=

# Development only
NEXT_PUBLIC_ADMIN_DEV_TOOLS=

# ───────────────────────── Convex (npx convex env set) ─────────────────────────
# CLERK_JWT_ISSUER_DOMAIN=https://clerk.physioaroundme.com
# CLERK_SECRET_KEY=
# CLERK_WEBHOOK_SECRET=
# CONVEX_SERVER_SECRET=
# CONVEX_JOY_GATEWAY_SECRET=
# CONVEX_JOY_READ_GATEWAY_SECRET=
# CONVEX_PARTNER_GATEWAY_SECRET=
# APP_URL=
# SITE_URL=
# NEXT_PUBLIC_APP_URL=
# PARTNER_API_BASE_URL=
# PAYSTACK_SECRET_KEY=
# PAYSTACK_WEBHOOK_SECRET=
# RESEND_API_KEY=
# FROM_NAME=
# ADMIN_EMAIL=
# PARTNER_OPERATIONS_EMAIL=
# STREAM_API_KEY=
# STREAM_SECRET=
# JOY_EVENT_URL=
# JOY_EVENT_HMAC_SECRET=
# JOY_WHATSAPP_NUMBER=
# EXERCISE_ASSET_MASTER_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# IMAGEKIT_PRIVATE_KEY=
# Rehabify Learn protected lesson videos (Bunny Stream, MediaCage Basic DRM + embed token auth).
# All four set = new lesson uploads go to Bunny; unset = ImageKit as before. See convex/helpers/bunnyStream.ts
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# BUNNY_STREAM_TOKEN_KEY=
# BUNNY_STREAM_CDN_HOST=
# LOCATIONIQ_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# WEBHOOK_SECRET=
# AI scribe (convex/scribe.ts, convex/helpers/llm.ts). Off unless SCRIBE_ENABLED=true.
# SCRIBE_ENABLED=
# SCRIBE_PHYSIO_EMAILS=          # optional, comma-separated: only these physio accounts can use it
# LLM_PROVIDER=openai            # openai (default) or gemini
# LLM_MODEL=                     # empty = gpt-5-mini (openai) / gemini-3.6-flash (gemini)
# LLM_REASONING_EFFORT=          # OpenAI gpt-5/o-series only; empty = low
# OPENAI_API_KEY=                # use a separate key just for the scribe
# GEMINI_API_KEY=                # only when LLM_PROVIDER=gemini (paid tier only for patient data)
# Leave unset in production (setup tools only):
# JOY_PROVIDER_BOOTSTRAP_SECRET=
# JOY_TEST_PROVIDER_SEED_SECRET=

# PostHog product analytics (EU). Loaded only after analytics consent; see lib/analytics/posthog.ts
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Blog (convex/blog.ts, app/blog). Set the SAME value on Vercel and on Convex (npx convex env set ... --prod).
# BLOG_REVALIDATE_SECRET lets Convex refresh /blog, the feed and the sitemap right after a publish.
# INDEXNOW_KEY (8-128 letters, numbers or hyphens) tells Bing and Yandex about new posts; served at /indexnow-key.txt.
BLOG_REVALIDATE_SECRET=
INDEXNOW_KEY=
