# Environment variables for Rehabify Health (physioaroundme.com).
# Names only: never put real values in this file. Set them in Vercel (Next.js) and Convex
# (`npx convex env set NAME value`). Locally, copy the Next.js block into .env.local.

# ───────────────────────── Next.js (Vercel) ─────────────────────────

# Convex
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
CONVEX_SITE_URL=
# Shared with Convex: lets API routes call server-only Convex functions
CONVEX_SERVER_SECRET=
CONVEX_JOY_GATEWAY_URL=
CONVEX_JOY_GATEWAY_SECRET=
CONVEX_PARTNER_GATEWAY_URL=
CONVEX_PARTNER_GATEWAY_SECRET=

# Clerk (read by @clerk/nextjs)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Site URLs
NEXT_PUBLIC_APP_URL=https://physioaroundme.com
APP_URL=
NEXT_PUBLIC_LEARN_URL=
NEXT_PUBLIC_ADMIN_URL=
PARTNER_API_BASE_URL=

# Offline mode (lib/pwa.ts, read at build time, so redeploy after changing it): "on" for everyone,
# "pilot" only for accounts an admin turned on in Admin > Users ("Offline pilot"), anything else off.
# Turning it off is the kill switch: phones wipe their stored pages and encrypted offline copy.
NEXT_PUBLIC_OFFLINE_MODE=

# Payments (Paystack): use live keys in production
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PLATFORM_FEE_AMOUNT=

# MediLoan by MyItura (MyItura sends the loan SMS)
MYITURA_API_URL=
MYITURA_PUBLIC_KEY=
MYITURA_SECRET_KEY=
MYITURA_WEBHOOK_SECRET=
MYITURA_WEBHOOK_TOKEN=

# AwaDOC referrals
AWADOC_API_KEY=
AWADOC_SECRET_KEY=
AWADOC_PARTNER_ID=
AWADOC_BASE_URL=
AWADOC_ENVIRONMENT=

# Joy (WhatsApp care assistant)
NEXT_PUBLIC_JOY_WHATSAPP_NUMBER=
JOY_EVENT_URL=
JOY_EVENT_HMAC_SECRET=
JOY_RH_INBOUND_KEY_ID=
JOY_RH_INBOUND_HMAC_SECRET=
JOY_SAFETY_ELIGIBILITY_URL=
JOY_SAFETY_HMAC_SECRET=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=
RESEND_FROM_EMAIL=
DEMO_REQUEST_EMAIL=
PLATFORM_ADMIN_EMAIL=

# Maps, media, analytics, monitoring
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=
NEXT_PUBLIC_WEB_VITALS_ENABLED=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: server/edge Sentry fall back to NEXT_PUBLIC_SENTRY_DSN
SENTRY_DSN=

# Rate limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Partner API key for server-to-server calls
REHABIFY_API_KEY=

# Development only
NEXT_PUBLIC_ADMIN_DEV_TOOLS=

