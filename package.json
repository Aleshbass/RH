    "test:treatment": "playwright test tests/features/treatment-plans.spec.ts",
    "test:auth": "playwright test tests/integration/auth-flow.spec.ts",
    "test:dashboard": "playwright test tests/physiotherapist-dashboard.spec.ts",
    "test:report": "playwright show-report",
    "test:env": "playwright test tests/environment.spec.ts",
    "test:install": "playwright install",
    "test:setup": "playwright install --with-deps",
    "test:ci": "playwright test --reporter=github",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "3d:build": "blender -b assets-src/3d/rehabify-character.blend -P scripts/exercise-3d/blender/build_all.py",
    "3d:pack": "node scripts/exercise-3d/pack-clips.mjs",
    "3d:publish": "node scripts/exercise-3d/publish.mjs",
    "audit": "npm audit --production",
    "analyze": "cross-env ANALYZE=true pnpm build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server pnpm build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser pnpm build"
  },
