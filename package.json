{
  "name": "rehabifyhealth",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "predev": "convex dev --until-success && convex dashboard",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:features": "playwright test tests/features",
    "test:integration": "playwright test tests/integration",
    "test:security": "playwright test tests/security",
    "test:performance": "playwright test tests/performance",
    "test:appointment": "playwright test tests/features/appointment-management.spec.ts",
    "test:patient": "playwright test tests/features/patient-management.spec.ts",
    "test:treatment": "playwright test tests/features/treatment-plans.spec.ts",
    "test:auth": "playwright test tests/integration/auth-flow.spec.ts",
    "test:dashboard": "playwright test tests/physiotherapist-dashboard.spec.ts",
    "test:report": "playwright show-report",
    "test:env": "playwright test tests/environment.spec.ts",
    "test:install": "playwright install",
    "test:setup": "playwright install --with-deps",
    "test:ci": "playwright test --reporter=github",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:codegen": "convex codegen",
    "audit": "npm audit --production"
  },
