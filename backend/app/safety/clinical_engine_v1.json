          "block_exercise": true
        }
      }
    },
    {
      "rule_id": "GEN-007",
      "name": "Unclear presentation",
      "body_region": "all",
      "priority": 60,
      "trigger": [
        "presentation_does_not_fit_clear_msk_pattern",
        "important_information_missing",
        "conflicting_patient_answers",
        "joy_low_confidence",
        "symptoms_outside_supported_pathways"
      ],
      "logic": {
        "triggered": "AMBER"
      },
      "actions": {
        "AMBER": {
          "book_5_min_specialist_review": true,
          "block_exercise": true
        }
      }
    }
  ],
