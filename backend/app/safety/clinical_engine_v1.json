{
  "engine": {
    "name": "Rehabify Clinical Safety Engine",
    "version": "1.0.0",
    "scope": "MSK",
    "purpose": "Identify potential safety concerns, determine whether a patient can proceed through the Rehabify MSK pathway, or route them to a 5-minute specialist triage review or appropriate medical/emergency care.",
    "principles": {
      "ai_does_not_make_final_safety_decision": true,
      "uncertainty_routes_to_specialist_review": true,
      "safety_overrides_convenience": true,
      "previous_clearance_does_not_override_new_symptoms": true,
      "no_autonomous_diagnosis": true
    },
    "outcomes": {
      "GREEN": {
        "meaning": "Suitable to continue the Rehabify MSK pathway based on information available.",
        "allow_standard_consultation": true,
        "allow_exercise_pathway": true,
        "allow_5_min_review": false
      },
      "AMBER": {
        "meaning": "Unclear or potentially concerning but not clearly an emergency.",
        "allow_standard_consultation": false,
        "allow_exercise_pathway": false,
        "allow_5_min_review": true
      },
      "ORANGE": {
        "meaning": "Requires appropriate medical or urgent clinical assessment before routine Rehabify rehabilitation.",
        "allow_standard_consultation": false,
        "allow_exercise_pathway": false,
        "allow_5_min_review": false,
        "requires_medical_review": true
      },
      "RED": {
        "meaning": "Potential emergency presentation requiring immediate emergency guidance.",
        "allow_standard_consultation": false,
        "allow_exercise_pathway": false,
        "allow_5_min_review": false,
        "requires_emergency_action": true
      }
    }
  },
  "general_rules": [
    {
      "rule_id": "GEN-001",
      "name": "Major trauma",
      "body_region": "all",
      "priority": 90,
      "questions": [
        {
          "id": "GEN-001-Q1",
          "text": "Did this problem start after a serious accident, major fall, road traffic accident, or significant injury?",
          "type": "yes_no"
        }
      ],
      "logic": {
        "yes": "ORANGE",
        "no": "CONTINUE",
        "unclear": "AMBER"
      },
      "actions": {
        "ORANGE": {
          "block_exercise": true,
          "block_routine_rehab": true,
          "recommend_medical_assessment": true,
          "audit": true
        },
        "AMBER": {
          "book_5_min_specialist_review": true,
          "block_exercise": true
        }
      }
    },
    {
      "rule_id": "GEN-002",
      "name": "Rapid deterioration",
      "body_region": "all",
      "priority": 80,
      "questions": [
        {
          "id": "GEN-002-Q1",
          "text": "Are your symptoms getting significantly worse very quickly?",
          "type": "yes_no"
        }
      ],
      "logic": {
        "yes": "AMBER",
        "no": "CONTINUE",
        "unclear": "AMBER"
      },
      "actions": {
        "AMBER": {
          "book_5_min_specialist_review": true,
          "block_exercise": true
        }
      }
    },
    {
      "rule_id": "GEN-003",
      "name": "Systemically unwell",
      "body_region": "all",
      "priority": 85,
      "questions": [
        {
          "id": "GEN-003-Q1",
          "text": "Have you recently had a fever, chills, night sweats, or felt significantly unwell alongside this problem?",
          "type": "yes_no"
        }
      ],
      "logic": {
        "yes": "AMBER",
        "no": "CONTINUE",
        "unclear": "AMBER"
      },
      "actions": {
        "AMBER": {
          "book_5_min_specialist_review": true,
          "block_exercise": true
        }
      }
    },
    {
      "rule_id": "GEN-004",
      "name": "Unexplained systemic change",
      "body_region": "all",
      "priority": 70,
      "questions": [
        {
          "id": "GEN-004-Q1",
          "text": "Have you had any unexplained weight loss, loss of appetite, or other major change in your general health recently?",
          "type": "yes_no"
        }
      ],
      "logic": {
        "yes": "AMBER",
        "no": "CONTINUE",
        "unclear": "AMBER"
      },
      "actions": {
        "AMBER": {
          "book_5_min_specialist_review": true,
          "block_exercise": true
        }
      }
    },
    {
      "rule_id": "GEN-005",
      "name": "Previous cancer with new MSK symptoms",
      "body_region": "all",
      "priority": 85,
      "questions": [
        {
          "id": "GEN-005-Q1",
          "text": "Have you ever been treated for cancer?",
          "type": "yes_no"
        }
      ],
      "follow_up_if_yes": [
        {
          "id": "GEN-005-Q2",
          "text": "Is this a new or unusual pain or symptom for you?",
          "type": "yes_no"
        }
      ],
      "logic": {
        "yes_plus_new_symptom": "AMBER",
        "yes_without_new_symptom": "CONTINUE",
        "no": "CONTINUE",
        "unclear": "AMBER"
      },
      "actions": {
        "AMBER": {
          "book_5_min_specialist_review": true,
          "block_exercise": true
        }
      }
    },
    {
      "rule_id": "GEN-006",
      "name": "Severe unexplained pain",
      "body_region": "all",
