# Local Docker defaults (see docs/local-development.md). Do not use a
# production/Railway database URL while developing Joy locally.
DATABASE_URL=postgresql+psycopg://joy:joy_local_only@127.0.0.1:55432/joy_dev
# Required only for database-backed pytest tests. Use an isolated Railway test
# database with the current schema; never set this to the production DATABASE_URL.
TEST_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:56379/0
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.0-flash
GEMINI_LIVE_MODEL=gemini-2.0-flash-live
# Optional text-provider selection. Keep Gemini as the default. An OpenAI or
# OpenRouter key is required only when its provider is selected.
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=
# At most one fallback model is attempted, and only for 429/502/503/504.
OPENROUTER_FALLBACK_MODELS=
LLM_PROVIDER_TIMEOUT_SECONDS=8
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved Meta template with one body variable {{1}}, used after the 24-hour window
WHATSAPP_UPDATE_TEMPLATE=
WHATSAPP_UPDATE_TEMPLATE_LANGUAGE=en
# Appointment confirmation and reminder email delivery (Resend). Use a
# verified sender domain/address in production.
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=Rehabify Joy
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=
JOY_ENVIRONMENT=development
# Required for the local browser console at /internal/dev/console. Generate
# one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
DEV_CONSOLE_TOKEN=
# Always true for local development: lets the worker run without contacting
# the Meta WhatsApp API.
DISABLE_WHATSAPP_DELIVERY=true
INTERNAL_API_SECRET=
INTERNAL_JOB_TOKEN=
RH_API_BASE_URL=
RH_API_KEY_ID=
RH_API_HMAC_SECRET=
# Optional direct, read-only RH Convex gateway. These are server-only values;
# the matching Convex secret is CONVEX_JOY_READ_GATEWAY_SECRET. Leave both
# blank to use RH's Vercel integration API for all reads.
RH_CONVEX_READ_BASE_URL=
RH_CONVEX_READ_HMAC_SECRET=
# Optional direct Joy -> RH Convex operational gateway. Use the Convex HTTP
# actions URL (not the public app URL). Its matching Convex deployment secret
# is CONVEX_JOY_GATEWAY_SECRET. Keep this distinct from the read-only key.
RH_CONVEX_GATEWAY_BASE_URL=
RH_CONVEX_GATEWAY_HMAC_SECRET=
# RH -> Joy safety and event authentication. Use independent production
# secrets; RH_EVENT_HMAC_SECRET must match Convex JOY_EVENT_HMAC_SECRET.
RH_SAFETY_HMAC_SECRET=
RH_EVENT_HMAC_SECRET=
# Operational release controls. Keep all enabled only after the matching RH
# integration deployment has been verified in the same environment.
RH_PHYSIO_OPERATIONS_ENABLED=true
RH_FAMILY_OPERATIONS_ENABLED=true
RH_RECONCILIATION_ENABLED=true
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_ENABLED=false
TYPESAFE_SHADOW_MODE=true
